SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key (Supabase dashboard > Project Settings > API). Required only
# for the RevenueCat webhook to grant practice credits via apply_credit_event.
# Never ship this to the Flutter client -- server/backend use only.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_LIVE_BRIDGE_URL=ws://127.0.0.1:8000/api/gemini-live
GEMINI_LIVE_SHARED_SECRET=
GEMINI_LIVE_API_PROVIDER=gemini
GEMINI_LIVE_MODEL=gemini-3.8-live
# Gemini Enterprise Agent Platform key for Live Avatar (video-call mode only).
# Create it in Google Cloud Console > Agent Platform > Authenticate for API access.
VERTEX_AGENT_PLATFORM_API_KEY=
GEMINI_AVATAR_LOCATION=us-central1
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_ANALYSIS_FALLBACK_MODEL=gemini-3.1-flash-lite
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_PUBLIC_SDK_KEY_WEB=
REVENUECAT_PUBLIC_SDK_KEY_APPLE=
REVENUECAT_PUBLIC_SDK_KEY_GOOGLE=
REVENUECAT_TEST_STORE_KEY=
REVENUECAT_USE_TEST_STORE=false
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_ORIGINS=
