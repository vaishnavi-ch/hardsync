# Copy to .env and fill in. Never commit real values.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Same values under the names the website/Next.js tooling uses (the API falls back to these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Admin key: used by supabase/functions and the tools/ review-account scripts. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (text drills and post-session reviews) ---
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_ANALYSIS_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- Tavus (video calls) ---
TAVUS_API_KEY=

# --- RevenueCat (subscriptions) ---
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_PUBLIC_SDK_KEY_WEB=
REVENUECAT_PUBLIC_SDK_KEY_APPLE=
REVENUECAT_PUBLIC_SDK_KEY_GOOGLE=
REVENUECAT_TEST_STORE_KEY=
REVENUECAT_USE_TEST_STORE=false

# --- API server ---
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_ORIGINS=

# --- Gemini Live bridge (old voice-call mode; still deployed as hardsync-live on Render) ---
# Local: ws://127.0.0.1:8000/api/gemini-live   Production: wss://hardsync-live.onrender.com/...
GEMINI_LIVE_BRIDGE_URL=ws://127.0.0.1:8000/api/gemini-live
GEMINI_LIVE_SHARED_SECRET=
GEMINI_LIVE_API_PROVIDER=gemini
GEMINI_LIVE_MODEL=gemini-3.8-live
GOOGLE_CLOUD_LOCATION=global
# Gemini Enterprise Agent Platform key for Live Avatar.
# Create it in Google Cloud Console > Agent Platform > Authenticate for API access.
VERTEX_AGENT_PLATFORM_API_KEY=
GEMINI_AVATAR_LOCATION=us-central1
# The bridge overrides this with certifi's bundle on startup; leave empty locally.
SSL_CERT_FILE=

# --- Cloudflare R2 (storage for the old opt-in call replays; replays were removed) ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_TOKEN=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# --- Not read by the current code (kept from earlier experiments) ---
# Google OAuth is configured in the Supabase dashboard, not read from here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LiveKit and LiveAvatar were tried for video calls before Tavus.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEAVATAR_API_KEY=
LIVEAVATAR_SANDBOX_MODE=true
